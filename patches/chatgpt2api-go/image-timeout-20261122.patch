+func TestImageStreamDiagnostics(t *testing.T) {
+	const privateText = "PRIVATE-PROMPT-AND-ERROR-DETAIL"
+	user := `{"v":{"conversation_id":"` + testCID + `","message":{"id":"u1","author":{"role":"user"},"content":{"content_type":"text","parts":["` + privateText + `"]},"status":"finished_successfully","end_turn":null}}}`
+	assistant := `{"v":{"message":{"id":"a1","author":{"role":"assistant"},"recipient":"all","content":{"content_type":"text","parts":["` + privateText + `"]},"status":"in_progress","end_turn":false}}}`
+	terminal := `{"v":{"message":{"id":"a1","author":{"role":"assistant"},"recipient":"image_gen","content":{"content_type":"code","text":"` + privateText + `"},"status":"finished_successfully","end_turn":false,"metadata":{"finish_details":{"type":"stop"}}}}}`
+	tool := func(ids string) string {
+		return `{"v":{"message":{"id":"t1","author":{"role":"tool"},"content":{"content_type":"multimodal_text","parts":[` + ids + `]},"status":"finished_successfully","metadata":{"async_task_type":"image_gen"}}}}`
+	}
+	cases := []struct {
+		name       string
+		response   fakeResponse
+		contextEnd string
+		wantError  bool
+		want       map[string]any
+	}{
+		{"200 non-SSE is still read to EOF", fakeResponse{status: 200, header: map[string][]string{"Content-Type": {"application/json; boundary=" + privateText}}, body: `{"detail":"` + privateText + `"}`}, "", false,
+			map[string]any{"reason": "eof", "content_type": "application/json", "sse_event_count": 0.0, "last_role": "unknown"}},
+		{"user-only EOF", sseResponse(user), "", false,
+			map[string]any{"reason": "eof", "conversation_id": testCID, "sse_event_count": 1.0, "assistant_role_events": 0.0, "tool_role_events": 0.0, "last_role": "user", "last_status": "finished_successfully", "last_end_turn": "unknown"}},
+		{"user-only DONE", sseResponse(user, "[DONE]"), "", false,
+			map[string]any{"reason": "done", "conversation_id": testCID, "sse_event_count": 2.0, "last_role": "user"}},
+		{"confirmed input size ends immediately with safe metadata", hangingSSE(user, `{"error":{"code":"input_too_large","message":"`+privateText+`"}}`), "", true,
+			map[string]any{"reason": "input_too_large", "last_role": "user", "last_payload_role": "unknown", "structured_error_seen": true, "failure_codes": []any{CodeRequestTooLarge}}},
+		{"roleless error stays observable after DONE", sseResponse(user, `{"type":"error","error":{"code":"upstream_model_not_found","message":"`+privateText+`"}}`, "[DONE]"), "", false,
+			map[string]any{"reason": "done", "last_event_type": "error", "last_role": "user", "last_payload_role": "unknown", "structured_error_seen": true, "failure_codes": []any{CodeModelNotFound}}},
+		{"terminal boundary behavior stays unchanged", hangingSSE(user, terminal), "", false,
+			map[string]any{"reason": "terminal", "sse_event_count": 2.0, "assistant_role_events": 1.0, "last_role": "assistant", "last_status": "finished_successfully", "last_end_turn": "false", "last_recipient": "image_gen", "last_payload_completion_marker": true}},
+		{"roleless stop is recorded without payload text", hangingSSE(user, `{"type":"stop","v":{"is_complete":true,"status":"finished_successfully","detail":"`+privateText+`"}}`), "", false,
+			map[string]any{"reason": "terminal", "last_event_type": "stop", "last_role": "user", "last_payload_role": "unknown", "last_payload_completion_marker": true, "assistant_role_events": 0.0}},
+		{"roleless patches keep message metadata", sseResponse(user, assistant, `{"o":"patch","v":[{"p":"/message/recipient","o":"replace","v":"image_gen"},{"p":"/message/status","o":"replace","v":"finished_successfully"},{"p":"/message/end_turn","o":"replace","v":false}]}`, "[DONE]"), "", false,
+			map[string]any{"reason": "done", "assistant_role_events": 1.0, "last_role": "assistant", "last_payload_role": "unknown", "last_status": "finished_successfully", "last_end_turn": "false", "last_recipient": "image_gen"}},
+		{"reference IDs are not generated images", sseResponse(user, tool(`{"asset_pointer":"file-service://file-UP1"}`), "[DONE]"), "", false,
+			map[string]any{"reason": "done", "tool_role_events": 1.0, "has_generated_image_id": false}},
+		{"generated IDs are observed", sseResponse(user, tool(`{"asset_pointer":"file-service://file-UP1"},{"asset_pointer":"file-service://`+testFileID+`"}`), "[DONE]"), "", false,
+			map[string]any{"reason": "done", "tool_role_events": 1.0, "has_generated_image_id": true}},
+		{"stream deadline", hangingSSE(user), "", true,
+			map[string]any{"reason": "deadline", "last_role": "user", "http_status": 200.0}},
+		{"read error detail is private", fakeResponse{status: 200, header: map[string][]string{"Content-Type": {"text/event-stream"}}, body: sseBody(user), fail: errors.New(privateText)}, "", true,
+			map[string]any{"reason": "read_error", "last_role": "user", "http_status": 200.0}},
+		{"non-2xx body is private", jsonResponse(403, `{"detail":"`+privateText+`"}`), "", true,
+			map[string]any{"reason": "http_status", "http_status": 403.0, "content_type": "application/json"}},
+		{"transport error detail is private", fakeResponse{err: errors.New(privateText)}, "", true,
+			map[string]any{"reason": "read_error", "http_status": 0.0, "content_type": "missing"}},
+		{"caller cancelled", fakeResponse{}, "cancelled", true,
+			map[string]any{"reason": "cancelled", "http_status": 0.0}},
+		{"caller deadline", fakeResponse{}, "deadline", true,
+			map[string]any{"reason": "deadline", "http_status": 0.0}},
+		{"unexpected correlation values stay private", sseResponse(`{"conversation_id":"`+testToken+`"}`, "[DONE]"), "", false,
+			map[string]any{"reason": "done", "conversation_id": "unknown"}},
+		{"unrecognized metadata never becomes log text", sseResponse(user, `{"type":"`+privateText+`","message":{"author":{"role":"assistant"},"recipient":"`+privateText+`","content":{"content_type":"text","parts":["`+testToken+`"]},"status":"`+privateText+`","end_turn":false},"error":{"code":"`+privateText+`"}}`, "[DONE]"), "", false,
+			map[string]any{"reason": "done", "last_event_type": "unknown", "last_status": "unknown", "last_recipient": "unknown", "structured_error_seen": true}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			ft := newFakeTransport(t)
+			cfg := chatConfig(t, ft)
+			var logs bytes.Buffer
+			cfg.Options.Logger = slog.New(slog.NewJSONHandler(&logs, nil))
+			cfg.Options.StreamTimeout = 25 * time.Millisecond
+			ft.on(routeConv, tc.response)
+			client, err := New(cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ctx := context.Background()
+			if tc.contextEnd == "cancelled" {
+				cancelled, cancel := context.WithCancel(ctx)
+				cancel()
+				ctx = cancelled
+			} else if tc.contextEnd == "deadline" {
+				expired, cancel := context.WithDeadline(ctx, time.Now().Add(-time.Second))
+				defer cancel()
+				ctx = expired
+			}
+			g := &generation{c: client, req: Request{Model: "gpt-image-2", Prompt: privateText}, prompt: privateText, state: newTurnState(), refs: []uploadedFile{{fileID: "file-UP1"}}}
+			err = g.runConversation(ctx, requirements{}, "CONDUIT-SECRET")
+			if (err != nil) != tc.wantError {
+				t.Fatalf("error presence = %v, want %v", err != nil, tc.wantError)
+			}
+			if ft.opened != ft.closed {
+				t.Errorf("opened %d bodies, closed %d", ft.opened, ft.closed)
+			}
+			var got map[string]any
+			if err := json.Unmarshal(bytes.TrimSpace(logs.Bytes()), &got); err != nil {
+				t.Fatalf("expected exactly one structured stream-end log: %v", err)
+			}
+			if got["msg"] != "image_stream_end" {
+				t.Errorf("event = %v", got["msg"])
+			}
+			for key, want := range tc.want {
+				if !reflect.DeepEqual(got[key], want) {
+					t.Errorf("%s = %v, want %v", key, got[key], want)
+				}
+			}
+			for _, secret := range []string{privateText, testToken, "CONDUIT-SECRET", "payload_preview", "file-UP1", testFileID} {
+				if strings.Contains(logs.String(), secret) {
+					t.Errorf("diagnostic log contains private data or raw preview: %s", secret)
+				}
+			}
+		})
 	}
 }
 
