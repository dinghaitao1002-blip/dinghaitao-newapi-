+// imageStreamDiagnostics never participates in generation decisions. Its
+// strings are closed enums: no payload, prompt, error detail or header values
+// other than a recognized media type are written to the diagnostic log.
+type imageStreamDiagnostics struct {
+	reason, contentType               string
+	httpStatus                        int
+	assistantEvents, toolEvents       int
+	eventType, role, status, endTurn  string
+	recipient, payloadRole, messageID string
+	completionMarker, errorSeen       bool
+	failureCodes                      []string
+}
+
+func imageStreamEnum(value string, allowed ...string) string {
+	value = pyLower(pyStrip(value))
+	for _, candidate := range allowed {
+		if value == candidate {
+			return candidate
+		}
+	}
+	return "unknown"
+}
+
+func imageStreamConversationID(value string) string {
+	// Conversation ids are UUIDs; an unexpected upstream value must not turn
+	// this correlation field into a channel for payload or credential text.
+	if len(value) != 36 {
+		return "unknown"
+	}
+	for i, ch := range value {
+		if i == 8 || i == 13 || i == 18 || i == 23 {
+			if ch != '-' {
+				return "unknown"
+			}
+		} else if !strings.ContainsRune("0123456789abcdefABCDEF", ch) {
+			return "unknown"
+		}
+	}
+	return value
+}
+
+func (d *imageStreamDiagnostics) contextEnd(err error) {
+	d.reason = "cancelled"
